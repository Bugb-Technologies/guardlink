{
  "table": "shell",
  "version": "2026-10",
  "about": "What trailing arbitrary arguments let a pre-approved command prefix do, independent of which harness approved it. A prefix rule such as `git log:*` approves every argument list after `git log`, so the question is what the worst argument list does. Keys are the first one or two words of the command.",
  "subcommand_scoped": ["git", "gh", "docker", "uv"],
  "classes": {
    "exec": { "effect": "execute", "admits": ["arbitrary-execution"], "severity": "high" },
    "net": { "effect": "notify", "admits": ["network-write"], "severity": "high" },
    "write": { "effect": "write", "admits": ["file-write"], "severity": "medium" },
    "read": { "effect": null, "admits": ["file-read-outside-repository"], "severity": "low" }
  },
  "prefixes": {
    "find": { "class": "exec", "why": "-exec/-execdir/-delete/-fprint run commands or write files" },
    "rg": { "class": "exec", "why": "--pre <cmd> runs a command per file" },
    "sed": { "class": "write", "why": "-i rewrites files; w writes arbitrary paths" },
    "awk": { "class": "exec", "why": "system() runs commands" },
    "gawk": { "class": "exec", "why": "system() runs commands" },
    "xargs": { "class": "exec", "why": "runs any command" },
    "env": { "class": "exec", "why": "runs any command" },
    "timeout": { "class": "exec", "why": "runs any command" },
    "nice": { "class": "exec", "why": "runs any command" },
    "watch": { "class": "exec", "why": "runs any command" },
    "nohup": { "class": "exec", "why": "runs any command" },
    "python": { "class": "exec", "why": "-c runs arbitrary code" },
    "python3": { "class": "exec", "why": "-c runs arbitrary code" },
    "node": { "class": "exec", "why": "-e runs arbitrary code" },
    "bash": { "class": "exec", "why": "-c runs arbitrary code" },
    "sh": { "class": "exec", "why": "-c runs arbitrary code" },
    "zsh": { "class": "exec", "why": "-c runs arbitrary code" },
    "deno": { "class": "exec", "why": "eval runs arbitrary code" },
    "bun": { "class": "exec", "why": "-e runs arbitrary code" },
    "ruby": { "class": "exec", "why": "-e runs arbitrary code" },
    "perl": { "class": "exec", "why": "-e runs arbitrary code" },
    "npx": { "class": "exec", "why": "runs any package from the registry" },
    "pnpx": { "class": "exec", "why": "runs any package from the registry" },
    "bunx": { "class": "exec", "why": "runs any package from the registry" },
    "uvx": { "class": "exec", "why": "runs any package from the registry" },
    "uv run": { "class": "exec", "why": "runs any command or script" },
    "docker": { "class": "exec", "why": "docker run/exec gives a root-equivalent shell" },
    "docker run": { "class": "exec", "why": "runs any image with any mounts" },
    "docker exec": { "class": "exec", "why": "a shell in a container" },
    "kubectl": { "class": "exec", "why": "exec/apply against the current cluster context" },
    "git": { "class": "exec", "why": "-c core.sshCommand, aliases, push and config run commands or publish" },
    "gh": { "class": "net", "why": "any GitHub API call with the developer's token, including writes" },
    "gh api": { "class": "net", "why": "any GitHub REST or GraphQL call with the developer's token, including POST and DELETE" },
    "curl": { "class": "net", "why": "any HTTP request: egress, and file writes with -o" },
    "wget": { "class": "net", "why": "any download, and file writes" },
    "ssh": { "class": "exec", "why": "a remote shell" },
    "scp": { "class": "net", "why": "copies files to remote hosts" },
    "rsync": { "class": "exec", "why": "-e runs a command; copies to remote hosts" },
    "make": { "class": "exec", "why": "runs any Makefile target, which the repository defines" },
    "tar": { "class": "exec", "why": "--to-command and --checkpoint-action run commands" },
    "zip": { "class": "exec", "why": "-T --unzip-command runs a command" },
    "git diff": { "class": "write", "why": "--output=<path> writes a file anywhere" },
    "git log": { "class": "write", "why": "--output=<path> writes a file anywhere" },
    "git show": { "class": "write", "why": "--output=<path> writes a file anywhere" },
    "chmod": { "class": "write", "why": "changes permissions on any path" },
    "rm": { "class": "write", "why": "deletes any path" },
    "cp": { "class": "write", "why": "writes any path" },
    "mv": { "class": "write", "why": "moves any path" },
    "tee": { "class": "write", "why": "writes any path" },
    "osascript": { "class": "exec", "why": "runs AppleScript" },
    "open": { "class": "exec", "why": "opens applications and URLs" },
    "cat": { "class": "read", "why": "reads any file on the machine (~/.ssh, ~/.aws), not only the repository" },
    "head": { "class": "read", "why": "reads any file on the machine" },
    "tail": { "class": "read", "why": "reads any file on the machine" },
    "less": { "class": "exec", "why": "!cmd runs a command" },
    "more": { "class": "exec", "why": "!cmd runs a command" },
    "vim": { "class": "exec", "why": "!cmd runs a command" },
    "man": { "class": "exec", "why": "the pager's !cmd runs a command" },
    "printenv": { "class": "read", "why": "prints the secrets in the environment" }
  },
  "command_tags": {
    "pipe-to-shell": "(curl|wget|iwr|Invoke-WebRequest)[^\\n|;]*\\|\\s*(sudo\\s+)?(ba|z|da)?sh\\b|\\|\\s*iex\\b|base64\\s+(-d|--decode)[^\\n]*\\|\\s*(ba|z)?sh",
    "net-fetch": "\\b(curl|wget|Invoke-WebRequest|iwr|http(ie)?)\\s|\\bfetch\\(\\s*['\"]https?://|https?://[^\\s'\"]+\\.(sh|py|ps1)\\b",
    "package-install": "\\b(npm|pnpm|yarn|bun)\\s+(i|install|add|ci)\\b|\\bpip3?\\s+install\\b|\\buv\\s+(sync|pip\\s+install|tool\\s+install)\\b|\\bbrew\\s+install\\b|\\bapt(-get)?\\s+install\\b|\\bcargo\\s+install\\b|\\bgo\\s+install\\b|\\bflox\\s+(install|activate)\\b|\\bmise\\s+install\\b|\\basdf\\s+install\\b",
    "remote-package-exec": "\\b(npx|pnpx|bunx|uvx)\\s|\\b(pnpm|yarn)\\s+dlx\\s|\\bpipx\\s+run\\s",
    "secrets-read": "~/\\.(ssh|aws|config/gh|netrc|npmrc|docker/config)|\\bprintenv\\b|\\benv\\s*\\||\\.env\\b|security\\s+find-generic-password|ANTHROPIC_API_KEY|GITHUB_TOKEN|AWS_SECRET",
    "privileged": "\\bsudo\\s|\\bchmod\\s+[0-7]*7[0-7]*\\s|\\bchown\\s",
    "destructive": "\\brm\\s+-[a-zA-Z]*r[a-zA-Z]*f|\\bgit\\s+(reset\\s+--hard|clean\\s+-[a-z]*f|push\\s+--force)",
    "network-send": "\\bcurl\\s[^\\n]*(-d|--data|-F|-X\\s*POST|--upload-file)|\\bnc\\s|\\bscp\\s|\\brsync\\s",
    "skip-permissions": "--dangerously-skip-permissions|--dangerously-bypass-approvals-and-sandbox|--yolo\\b|--approval-mode[= ]yolo|--full-auto\\b|--allow-all-tools\\b|--trust-all-tools\\b|--permission-mode[= ]bypassPermissions|--no-interactive\\s+--auto"
  }
}
